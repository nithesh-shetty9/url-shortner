<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --primary-light: #eff6ff;
            --primary-border: #bfdbfe;
            --accent: #4f46e5;
            --bg-base: #f8fafc;
            --surface-card: #ffffff;
            --surface-muted: #f1f5f9;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --text-subtle: #94a3b8;
            --border-light: #e2e8f0;
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 18px;
            --shadow-card: 0 10px 25px -5px rgba(15, 23, 42, 0.06), 0 8px 10px -6px rgba(15, 23, 42, 0.04);
            --shadow-hover: 0 14px 28px -4px rgba(37, 99, 235, 0.12);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-base);
            color: var(--text-main);
            min-height: 100vh;
            padding: 48px 20px;
            position: relative;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }
        .glow-bg {
            position: fixed;
            top: -100px;
            left: 50%;
            transform: translateX(-50%);
            width: 650px;
            height: 350px;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.08) 0%, rgba(79, 70, 229, 0.03) 60%, transparent 80%);
            pointer-events: none;
            z-index: 0;
        }

        .wrapper {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 820px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 28px;
        }
        .app-header {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            background: var(--primary-light);
            color: var(--primary);
            font-size: 13px;
            font-weight: 600;
            border-radius: 9999px;
            border: 1px solid var(--primary-border);
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            background-color: var(--primary);
            border-radius: 50%;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.25);
        }

        .logo-box {
            width: 48px;
            height: 48px;
            border-radius: var(--radius-md);
            background: linear-gradient(135deg, #2563eb, #4f46e5);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            box-shadow: 0 8px 16px -4px rgba(37, 99, 235, 0.35);
        }

        h1 {
            font-size: 32px;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: -0.025em;
        }

        .subtitle {
            max-width: 520px;
            color: var(--text-muted);
            font-size: 15px;
        }

        /* Main Container Card */
        .container {
            background: var(--surface-card);
            padding: 36px 40px;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-card);
            border: 1px solid var(--border-light);
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        /* Result Box */
        .result {
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
            border: 1.5px solid var(--primary-border);
            border-radius: var(--radius-md);
            padding: 18px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .result-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 220px;
        }

        .result-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #0369a1;
        }

        .result-link {
            font-family: 'JetBrains Mono', monospace;
            font-size: 16px;
            font-weight: 700;
            color: var(--primary);
            text-decoration: none;
            word-break: break-all;
        }

        .result-link:hover {
            text-decoration: underline;
        }

        .result-actions {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        form {
            display: flex;
            gap: 12px;
            width: 100%;
        }

        .input-wrap {
            position: relative;
            flex: 1;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 16px;
            color: var(--text-subtle);
            font-size: 16px;
            pointer-events: none;
        }

        input[type="url"] {
            width: 100%;
            padding: 15px 16px 15px 44px;
            border: 1.5px solid var(--border-light);
            border-radius: var(--radius-md);
            font-size: 15px;
            font-family: inherit;
            color: var(--text-main);
            background: #ffffff;
            outline: none;
            transition: all 0.2s ease;
        }

        input[type="url"]:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
        }

        button, .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 15px 26px;
            border: none;
            border-radius: var(--radius-md);
            background: linear-gradient(135deg, #2563eb, #4f46e5);
            color: white;
            font-size: 15px;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            text-decoration: none;
            white-space: nowrap;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
            transition: all 0.2s ease;
        }

        button:hover, .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35);
        }

        button:active, .btn:active {
            transform: translateY(0);
        }

        .btn-copy {
            padding: 9px 16px;
            font-size: 13px;
            background: #ffffff;
            color: var(--text-main);
            border: 1px solid var(--primary-border);
            box-shadow: none;
        }

        .btn-copy:hover {
            background: #f8fafc;
            border-color: #93c5fd;
            color: var(--primary);
            transform: none;
        }
        .recent {
            background: var(--surface-card);
            padding: 32px 36px;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-card);
            border: 1px solid var(--border-light);
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .recent-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border-light);
            padding-bottom: 14px;
        }

        .recent-header h2 {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-main);
        }

        .badge-count {
            padding: 4px 10px;
            background: var(--surface-muted);
            border-radius: 9999px;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
        }

        ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        li {
            padding: 16px 20px;
            background: #ffffff;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            transition: all 0.2s ease;
        }

        li:hover {
            border-color: #cbd5e1;
            box-shadow: 0 4px 12px -2px rgba(15, 23, 42, 0.05);
            transform: translateY(-1px);
        }

        .url-info {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
            flex: 1;
        }

        .short-code-tag {
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            font-weight: 700;
            color: var(--primary);
            background: var(--primary-light);
            padding: 4px 8px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--primary-border);
            text-decoration: none;
            white-space: nowrap;
        }

        .arrow {
            color: var(--text-subtle);
            font-size: 13px;
            user-select: none;
        }

        .original-url {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 14px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            flex: 1;
        }

        .original-url:hover {
            color: var(--text-main);
            text-decoration: underline;
        }

        .list-meta {
            display: flex;
            align-items: center;
            gap: 12px;
            white-space: nowrap;
        }

        .clicks {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
            background: var(--surface-muted);
            padding: 4px 10px;
            border-radius: 9999px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .btn-mini-copy {
            padding: 6px 10px;
            font-size: 12px;
            border-radius: var(--radius-sm);
            background: #ffffff;
            border: 1px solid var(--border-light);
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.15s;
        }

        .btn-mini-copy:hover {
            background: var(--surface-muted);
            color: var(--primary);
            border-color: var(--primary-border);
        }

        .empty-state {
            text-align: center;
            padding: 32px 20px;
            color: var(--text-muted);
            font-size: 14px;
        }
        #toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: #0f172a;
            color: #ffffff;
            padding: 10px 18px;
            border-radius: var(--radius-sm);
            font-size: 13px;
            font-weight: 500;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
            opacity: 0;
            pointer-events: none;
            transform: translateY(8px);
            transition: all 0.25s ease;
            z-index: 999;
        }

        #toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        /* Responsive Mobile Layout */
        @media (max-width: 640px) {
            body {
                padding: 24px 14px;
            }

            .container {
                padding: 24px 18px;
            }
            .recent {
                padding: 20px 16px;
            }
            h1 {
                font-size: 24px;
            }          form {
                flex-direction: column;
            }
            button {
                width: 100%;
            }
            li {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
                padding: 14px;
            }
            .url-info {
                width: 100%;
                flex-wrap: wrap;
                gap: 8px;
            }
            .original-url {
                width: 100%;
                flex: none;
            }
            .list-meta {
                width: 100%;
                justify-content: space-between;
                border-top: 1px solid #f1f5f9;
                padding-top: 8px;
            }
        }
    </style>
</head>
<body>
    <div class="glow-bg"></div>
    <div class="wrapper">
        <header class="app-header">
            <div class="brand-badge">
                <span class="pulse-dot"></span>
                <span>Fast & Secure Link Shortener</span>
            </div>
            <div class="logo-box">🔗</div>
            <h1>URL Shortener</h1>
            <p class="subtitle">Turn long URLs into short, memorable, and shareable links in seconds.</p>
        </header>
        <main class="container">
            <% if (typeof shorturl !== 'undefined' && shorturl) { %>
                <div class="result">
                    <div class="result-info">
                        <span class="result-label">Your Shortened URL</span>
                        <a href="<%= shorturl %>" target="_blank" class="result-link" id="generatedUrl">
                            <%= shorturl %>
                        </a>
                    </div>
                    <div class="result-actions">
                        <button type="button" class="btn-copy" onclick="copyLink('<%= shorturl %>')">
                            📋 Copy Link
                        </button>
                    </div>
                </div>
            <% } %>
            <form method="POST" action="/url">
                <div class="input-wrap">
                    <span class="input-icon">🌐</span>
                    <input
                        type="url"
                        name="url"
                        placeholder="https://example.com/very-long-url-to-shorten"
                        required
                        autocomplete="off">
                </div>
                //name is the key which helps to acess the url in the backend and the value is the url which is entered by the user
                <button type="submit">
                    Shorten URL
                </button>
            </form>
        </main>
        <section class="recent">
            <div class="recent-header">
                <h2>Recent URLs</h2>
                <span class="badge-count"><%= (typeof urls !== 'undefined' ? urls.length : 0) %> links</span>
            </div>

            <% if (typeof urls !== 'undefined' && urls.length > 0) { %>
                <ul>
                    <% urls.forEach(url => { %>
                        <li>
                            <div class="url-info">
                                <a
                                    href="/url/<%= url.shortCode %>"
                                    target="_blank"
                                    class="short-code-tag"
                                    title="Open short link"
                                >
                                    /<%= url.shortCode %>
                                </a>
                                <span class="arrow">→</span>
                                <a
                                    href="<%= url.originalUrl %>"
                                    target="_blank"
                                    class="original-url"
                                    title="<%= url.originalUrl %>"
                                >
                                    <%= url.originalUrl %>
                                </a>
                            </div>

                            <div class="list-meta">
                                <span class="clicks">
                                    📊 <%= url.clicks || 0 %> clicks
                                </span>
                                <button
                                    type="button"
                                    class="btn-mini-copy"
                                    onclick="copyShortCode('/url/<%= url.shortCode %>')"
                                    title="Copy short link"
                                >
                                    Copy
                                </button>
                            </div>
                        </li>
                    <% }); %>
                </ul>
            <% } else { %>
                <div class="empty-state">
                    No shortened URLs yet. Enter a destination link above!
                </div>
            <% } %>
        </section>
    </div>
    <div id="toast">Copied to clipboard!</div>
    <script>
        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 2200);
        }

        function copyLink(url) {
            navigator.clipboard.writeText(url).then(() => {
                showToast('Short URL copied to clipboard!');
            }).catch(() => {
                showToast('Failed to copy');
            });
        }

        function copyShortCode(path) {
            const fullUrl = window.location.origin + path;
            copyLink(fullUrl);
        }
    </script>
</body>
</html>