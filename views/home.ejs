<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener</title>

    <style>
        @layer reset, tokens, base, layout, components;

        @layer reset {
            *, *::before, *::after {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html {
                color-scheme: light;
                -webkit-text-size-adjust: 100%;
            }

            a { color: inherit; }
        }

        @layer tokens {
            :root {
                /* Type — a warm serif for the headline, a plain sans for everything
                   that needs to be read quickly. */
                --font-display: Georgia, "Iowan Old Style", "Palatino Linotype", serif;
                --font-body: "Segoe UI", system-ui, -apple-system, Roboto, sans-serif;
                --font-mono: "SF Mono", Consolas, "Liberation Mono", monospace;

                /* Calm, low-saturation palette — soft paper, muted sage-teal accent,
                   warm charcoal text instead of pure black. Nothing neon. */
                --paper:        #f6f4ef;
                --card:         #fffdf9;
                --line:         #e4ddd0;
                --ink:          #3a352c;
                --ink-soft:     #6b6456;
                --ink-faint:    #948c7c;
                --moss:         #5c7a6b;
                --moss-deep:    #47614f;
                --moss-wash:    #ecf1ec;
                --moss-line:    #cfdcd2;

                --space-2: 0.5rem;
                --space-3: 0.85rem;
                --space-4: 1.25rem;
                --space-5: 2rem;
                --space-6: 3rem;

                --radius: 12px;
                --radius-lg: 18px;
                --ring: 0 0 0 3px rgba(92, 122, 107, 0.25);
            }
        }

        @layer base {
            body {
                font-family: var(--font-body);
                background: var(--paper);
                color: var(--ink);
                line-height: 1.6;
                min-height: 100dvh;

                /* Responsive outer padding: tight on phones, roomy on desktop */
                padding: var(--space-5) var(--space-3);
            }

            @media (min-width: 640px) {
                body { padding: var(--space-6) var(--space-4); }
            }
        }

        @layer layout {
            .wrapper {
                width: 100%;
                max-width: 640px;
                margin-inline: auto;
                display: flex;
                flex-direction: column;
                gap: var(--space-4);
            }

            form {
                display: flex;
                flex-direction: column;
                gap: var(--space-2);
            }

            /* Side-by-side input/button once there's room for both without
               squeezing the input under ~14 characters. */
            @media (min-width: 480px) {
                form {
                    flex-direction: row;
                }
            }
        }

        @layer components {
            .container {
                background: var(--card);
                padding: var(--space-4);
                border-radius: var(--radius-lg);
                border: 1px solid var(--line);
                text-align: center;
            }

            @media (min-width: 640px) {
                .container { padding: var(--space-5) var(--space-6); }
            }

            .logo {
                font-size: 2rem;
                margin-bottom: var(--space-2);
            }

            h1 {
                font-family: var(--font-display);
                font-weight: 400;
                font-size: 1.6rem;
                letter-spacing: -0.01em;
                margin-bottom: var(--space-2);
                color: var(--ink);
            }

            @media (min-width: 640px) {
                h1 { font-size: 2rem; }
            }

            .subtitle {
                color: var(--ink-soft);
                margin-bottom: var(--space-4);
                font-size: 0.95rem;
                max-width: 32ch;
                margin-inline: auto;
            }

            input {
                width: 100%;
                padding: 0.9em 1em;
                border: 1px solid var(--line);
                border-radius: var(--radius);
                font-size: 1rem;
                font-family: inherit;
                background: var(--paper);
                color: var(--ink);
                outline: none;
                transition: border-color 0.15s ease, box-shadow 0.15s ease;
            }

            @media (min-width: 480px) {
                input { flex: 1; }
            }

            input::placeholder { color: var(--ink-faint); }

            input:focus-visible {
                border-color: var(--moss);
                box-shadow: var(--ring);
            }

            button {
                padding: 0.9em 1.6em;
                border: none;
                border-radius: var(--radius);
                background: var(--moss);
                color: var(--card);
                font-size: 1rem;
                font-weight: 600;
                font-family: inherit;
                cursor: pointer;
                transition: background-color 0.15s ease;
            }

            button:hover { background: var(--moss-deep); }
            button:focus-visible { box-shadow: var(--ring); }

            .result {
                margin-bottom: var(--space-4);
                padding: var(--space-3);
                background: var(--moss-wash);
                border: 1px solid var(--moss-line);
                border-radius: var(--radius);
                text-align: left;
            }

            .result p {
                color: var(--ink-soft);
                font-size: 0.85rem;
                margin-bottom: 0.3em;
            }

            .result a {
                display: inline-block;
                color: var(--moss-deep);
                font-weight: 600;
                font-family: var(--font-mono);
                font-size: 0.95rem;
                text-decoration: none;
                word-break: break-all;
            }

            .result a:hover { text-decoration: underline; }
            .result a:focus-visible { box-shadow: var(--ring); border-radius: 4px; }

            .recent {
                background: var(--card);
                padding: var(--space-4);
                border-radius: var(--radius-lg);
                border: 1px solid var(--line);
            }

            @media (min-width: 640px) {
                .recent { padding: var(--space-5) var(--space-6); }
            }

            .recent h2 {
                font-family: var(--font-display);
                font-weight: 400;
                font-size: 1.2rem;
                margin-bottom: var(--space-3);
                text-align: left;
                color: var(--ink);
            }

            ul {
                list-style: none;
                display: flex;
                flex-direction: column;
            }

            li {
                padding: var(--space-3) 0;
                border-bottom: 1px solid var(--line);
                display: flex;
                flex-direction: column;
                gap: 0.4em;
            }

            /* On wider screens the click count sits beside the link row
               instead of stacking underneath it. */
            @media (min-width: 560px) {
                li {
                    flex-direction: row;
                    align-items: baseline;
                    justify-content: space-between;
                    gap: var(--space-3);
                }
            }

            li:last-child { border-bottom: none; }

            .url-info {
                display: flex;
                align-items: center;
                gap: var(--space-2);
                min-width: 0;
                flex-wrap: wrap;
            }

            @media (min-width: 560px) {
                .url-info { flex: 1 1 auto; flex-wrap: nowrap; }
            }

            .url-info strong {
                font-family: var(--font-mono);
                font-size: 0.8rem;
                color: var(--ink-soft);
                background: var(--paper);
                border: 1px solid var(--line);
                padding: 0.2em 0.5em;
                border-radius: 6px;
                flex-shrink: 0;
            }

            .arrow {
                color: var(--ink-faint);
                flex-shrink: 0;
            }

            .short-url {
                color: var(--moss-deep);
                font-weight: 600;
                text-decoration: none;
                flex-shrink: 0;
            }

            .short-url:hover { text-decoration: underline; }

            .original-url {
                color: var(--ink-soft);
                text-decoration: none;
                font-size: 0.9rem;
                min-width: 0;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                width: 100%;
            }

            @media (min-width: 560px) {
                .original-url { width: auto; }
            }

            .original-url:hover {
                text-decoration: underline;
                color: var(--ink);
            }

            a:focus-visible {
                outline: none;
                box-shadow: var(--ring);
                border-radius: 4px;
            }

            .clicks {
                color: var(--ink-faint);
                font-size: 0.85rem;
                white-space: nowrap;
                flex-shrink: 0;
            }
        }
    </style>
</head>

<body>
    <div class="wrapper">
        <div class="container">
            <div class="logo">🔗</div>
            <h1>URL Shortener</h1>
            <p class="subtitle">Turn long URLs into short, shareable links.</p>

            <% if (shorturl) { %>
                <div class="result">
                    <p>Your shortened URL:</p>
                    <a href="/url/<%= shorturl %>" target="_blank">
                        <%= shorturl %>
                    </a>
                </div>
            <% } %>

            <form method="POST" action="/url">
                <input
                    type="url"
                    name="url"
                    placeholder="https://example.com/very-long-url"
                    required
                >
                <button type="submit">Shorten URL</button>
            </form>
        </div>

        <div class="recent">
            <h2>Recent URLs</h2>
            <ul>
                <% urls.forEach(url => { %>
                    <li>
                        <div class="url-info">
                            <strong><%= url.shortCode %></strong>
                            <span class="arrow">&rarr;</span>
                            <a href="/url/<%= url.shortCode %>" target="_blank" class="short-url">
                                /<%= url.shortCode %>
                            </a>
                            <span class="arrow">&rarr;</span>
                            <a href="<%= url.originalUrl %>" target="_blank" class="original-url">
                                <%= url.originalUrl %>
                            </a>
                        </div>
                        <span class="clicks">🔗 <%= url.clicks %> clicks</span>
                    </li>
                <% }); %>
            </ul>
        </div>
    </div>
</body>
</html>
